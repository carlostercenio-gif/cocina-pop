<script>
// ============================================================
// PWA - SERVICE WORKER + MANIFEST
// ============================================================
const MANIFEST = {
  name: "Cocina Pop — Finanzas",
  short_name: "Cocina Pop",
  description: "Finanzas para tu negocio",
  start_url: "/",
  display: "standalone",
  background_color: "#0f0f1a",
  theme_color: "#f72585",
  orientation: "portrait",
  icons: [
    { src: "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 192 192'><rect width='192' height='192' rx='40' fill='%231a1a2e'/><text y='130' x='96' text-anchor='middle' font-size='100'>🍳</text></svg>", sizes: "192x192", type: "image/svg+xml" },
    { src: "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512'><rect width='512' height='512' rx='100' fill='%231a1a2e'/><text y='360' x='256' text-anchor='middle' font-size='280'>🍳</text></svg>", sizes: "512x512", type: "image/svg+xml" }
  ]
};

// Inyectar manifest dinámico
const manifestBlob = new Blob([JSON.stringify(MANIFEST)], {type: 'application/json'});
const manifestURL = URL.createObjectURL(manifestBlob);
document.querySelector('link[rel="manifest"]').href = manifestURL;

// Registrar Service Worker inline
const SW_CODE = `
const CACHE = 'cocina-pop-v1';
const ASSETS = ['/'];

self.addEventListener('install', e => {
  e.waitUntil(caches.open(CACHE).then(c => c.addAll(ASSETS)));
  self.skipWaiting();
});

self.addEventListener('activate', e => {
  e.waitUntil(caches.keys().then(keys =>
    Promise.all(keys.filter(k => k !== CACHE).map(k => caches.delete(k)))
  ));
  self.clients.claim();
});

self.addEventListener('fetch', e => {
  e.respondWith(
    caches.match(e.request).then(r => r || fetch(e.request).catch(() =>
      caches.match('/')
    ))
  );
});
`;

if ('serviceWorker' in navigator) {
  const swBlob = new Blob([SW_CODE], {type: 'application/javascript'});
  const swURL = URL.createObjectURL(swBlob);
  navigator.serviceWorker.register(swURL, {scope: '/'}).catch(() => {});
}

// Install prompt
let deferredPrompt = null;

window.addEventListener('beforeinstallprompt', (e) => {
  e.preventDefault();
  deferredPrompt = e;
  setTimeout(() => {
    document.getElementById('installBanner').classList.add('show');
  }, 3000);
});

window.addEventListener('appinstalled', () => {
  document.getElementById('installBanner').classList.remove('show');
  showToast('✓ App instalada correctamente');
});

function instalarApp() {
  if (deferredPrompt) {
    deferredPrompt.prompt();
    deferredPrompt.userChoice.then(() => {
      deferredPrompt = null;
      cerrarBanner();
    });
  }
}

function cerrarBanner() {
  document.getElementById('installBanner').classList.remove('show');
}

// ============================================================
// STATE
// ============================================================
let state = {
  transactions: [],
  config: {
    equilibrio: 300000,
    pctOp: 50,
    pctPer: 35,
    pctAho: 15,
    efectivo: 0,
    mp: 0,
    banco: 0,
    alquiler: 500000,
    servicios: 0,
    mono: 0,
    personalFijo: 0
  },
  bolsas: { op: 0, per: 0, aho: 0 }
};

let currentType = 'ingreso';
const DIAS = ['Lun','Mar','Mié','Jue','Vie'];

const CATEGORIAS = {
  ingreso: [
    { id: 'venta', label: '💰 Venta del día' },
    { id: 'delivery', label: '🛵 Delivery' },
    { id: 'market', label: '🧊 Market/Congelados' },
    { id: 'otro-ing', label: '➕ Otro ingreso' }
  ],
  gasto: [
    { id: 'mercaderia', label: '🥩 Mercadería' },
    { id: 'alquiler', label: '🏪 Alquiler' },
    { id: 'servicios', label: '💡 Servicios' },
    { id: 'colegio', label: '📚 Colegio/Educación' },
    { id: 'auto', label: '🚗 Auto/Combustible' },
    { id: 'salud', label: '❤️ Salud/Obra social' },
    { id: 'casa', label: '🏠 Casa/Expensas' },
    { id: 'personal', label: '👤 Gasto personal' },
    { id: 'otro-g', label: '📌 Otro' }
  ],
  compra: [
    { id: 'stock-normal', label: '📦 Stock normal' },
    { id: 'stock-oferta', label: '🏷️ Oferta/Oportunidad' },
    { id: 'stock-estrategico', label: '🎯 Compra estratégica' },
    { id: 'mejora', label: '🔧 Mejora del negocio' }
  ]
};

let selectedCat = null;

// ============================================================
// INIT
// ============================================================
function init() {
  const saved = localStorage.getItem('cocinapop');
  if (saved) {
    const data = JSON.parse(saved);
    state = { ...state, ...data };
  }
  setDate();
  loadConfig();
  renderCats('ingreso');
  updateDashboard();
}

function setDate() {
  const d = new Date();
  const dias = ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'];
  const meses = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
  document.getElementById('dateChip').textContent = `${dias[d.getDay()]} ${d.getDate()} ${meses[d.getMonth()]}`;
}

function save() {
  localStorage.setItem('cocinapop', JSON.stringify(state));
}

// ============================================================
// NAVIGATION
// ============================================================
function showScreen(name, tabEl, navId) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById('screen-' + name).classList.add('active');

  if (tabEl) {
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    tabEl.classList.add('active');
  }

  if (navId) {
    document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
    document.getElementById(navId).classList.add('active');
    const tabMap = { 'nav-dashboard': 0, 'nav-movimientos': 2, 'nav-cargar': 1, 'nav-config': 3 };
    const tabs = document.querySelectorAll('.tab');
    if (tabMap[navId] !== undefined) {
      tabs.forEach(t => t.classList.remove('active'));
      tabs[tabMap[navId]].classList.add('active');
    }
  }

  if (name === 'movimientos') renderAllTx();
  if (name === 'dashboard') updateDashboard();
}

// ============================================================
// DASHBOARD
// ============================================================
function updateDashboard() {
  const cfg = state.config;
  const txs = state.transactions;

  const saldoInicial = (cfg.efectivo || 0) + (cfg.mp || 0) + (cfg.banco || 0);

  let op = 0, per = 0, aho = 0;
  let ventasHoy = 0, ventasMes = 0;
  const hoy = new Date(); hoy.setHours(0,0,0,0);
  const primerMes = new Date(hoy.getFullYear(), hoy.getMonth(), 1);
  const ventasSemana = [0, 0, 0, 0, 0];

  txs.forEach(tx => {
    const d = new Date(tx.date);
    const dSolo = new Date(d); dSolo.setHours(0,0,0,0);

    if (tx.type === 'ingreso') {
      const pOp = (tx.amount * cfg.pctOp) / 100;
      const pPer = (tx.amount * cfg.pctPer) / 100;
      const pAho = (tx.amount * cfg.pctAho) / 100;
      op += pOp; per += pPer; aho += pAho;

      if (dSolo.getTime() === hoy.getTime()) ventasHoy += tx.amount;
      if (d >= primerMes) ventasMes += tx.amount;

      const dow = d.getDay();
      if (dow >= 1 && dow <= 5) {
        const weekStart = new Date(hoy);
        weekStart.setDate(hoy.getDate() - hoy.getDay() + 1);
        if (d >= weekStart) ventasSemana[dow - 1] += tx.amount;
      }
    } else {
      op -= tx.amount;
    }
  });

  op += saldoInicial * (cfg.pctOp / 100);
  per += saldoInicial * (cfg.pctPer / 100);
  aho += saldoInicial * (cfg.pctAho / 100);

  const total = op + per + aho;

  const dispEl = document.getElementById('disponibleAmount');
  dispEl.textContent = fmt(total);
  dispEl.className = 'status-amount ' + (total > 0 ? 'green' : 'red');

  document.getElementById('chip-op').textContent = `Operativo ${fmt(op)}`;
  document.getElementById('chip-per').textContent = `Personal ${fmt(per)}`;
  document.getElementById('chip-aho').textContent = `Ahorro ${fmt(aho)}`;
  document.getElementById('mini-op').textContent = fmt(Math.max(0, op));
  document.getElementById('mini-per').textContent = fmt(Math.max(0, per));
  document.getElementById('mini-aho').textContent = fmt(Math.max(0, aho));
  document.getElementById('mini-mes').textContent = fmt(ventasMes);

  const eq = cfg.equilibrio || 300000;
  const pct = Math.min(Math.round((ventasHoy / eq) * 100), 100);
  const eqBar = document.getElementById('eqBar');
  eqBar.style.width = pct + '%';

  let eqClass = 'red';
  if (pct >= 100) eqClass = 'green';
  else if (pct >= 60) eqClass = 'yellow';

  eqBar.className = 'progress-fill ' + eqClass;
  document.getElementById('eqProgressLabel').textContent = `${fmt(ventasHoy)} / ${fmt(eq)}`;
  document.getElementById('eqBadge').textContent = pct >= 100 ? '✓ OK' : pct >= 60 ? 'Cerca' : 'Bajo';
  document.getElementById('eqBadge').className = 'badge ' + eqClass;

  let eqMsg = '';
  if (ventasHoy === 0) eqMsg = 'Cargá las ventas del día para ver cómo estás parado.';
  else if (pct >= 100) eqMsg = `🟢 Superaste el punto de equilibrio. Llevás ${fmt(ventasHoy - eq)} de ganancia pura hoy.`;
  else if (pct >= 60) eqMsg = `🟡 Vas bien. Te faltan ${fmt(eq - ventasHoy)} para cubrir el día.`;
  else eqMsg = `🔴 Día difícil. Te faltan ${fmt(eq - ventasHoy)} para el equilibrio.`;
  document.getElementById('eqMessage').textContent = eqMsg;

  renderAlertas(op, per, aho, ventasHoy, eq);
  renderWeekChart(ventasSemana, eq);
  renderLastTx();

  const dias5 = ventasSemana.filter(v => v > 0);
  const prom = dias5.length ? dias5.reduce((a, b) => a + b, 0) / dias5.length : 0;
  document.getElementById('promedioDiario').textContent = fmt(prom);
  const max = Math.max(...ventasSemana);
  const idxMax = ventasSemana.indexOf(max);
  document.getElementById('mejorDia').textContent = max > 0 ? `${DIAS[idxMax]} ${fmt(max)}` : '—';
}

function renderAlertas(op, per, aho, ventasHoy, eq) {
  const container = document.getElementById('alertContainer');
  const cfg = state.config;
  let html = '';

  if (op < 0) {
    html += alerta('danger', '⚠️', 'Caja operativa negativa', 'Estás usando plata que no tenés en el negocio. Cuidado.');
  } else if (op < cfg.alquiler) {
    html += alerta('warn', '🔔', 'Poco fondo operativo', `Tenés menos de un alquiler en operativo (${fmt(cfg.alquiler)}).`);
  }

  if (ventasHoy === 0 && new Date().getDay() >= 1 && new Date().getDay() <= 5) {
    html += alerta('neutral', '📝', 'Sin ventas registradas hoy', 'No olvidés cargar las ventas del día.');
  }

  if (aho <= 0) {
    html += alerta('warn', '🐖', 'Sin colchón de ahorro', 'Todavía no tenés reserva. Cada ingreso aparta un poco.');
  }

  if (!html) {
    if (op > 0 && per > 0) html += alerta('good', '✅', '¡Todo en orden!', 'La caja operativa y personal están en verde.');
  }

  container.innerHTML = html;
}

function alerta(tipo, icon, titulo, texto) {
  return `<div class="alert-card ${tipo}"><div class="alert-icon">${icon}</div><div class="alert-text"><strong>${titulo}</strong>${texto}</div></div>`;
}

function renderWeekChart(data, eq) {
  const max = Math.max(...data, eq * 1.2, 1);
  const wrap = document.getElementById('weekChart');
  let html = '';
  data.forEach((v, i) => {
    const h = Math.round((v / max) * 72);
    let color = v === 0 ? 'var(--surface2)' : v >= eq ? 'var(--green)' : v >= eq * 0.6 ? 'var(--yellow)' : 'var(--red)';
    html += `<div class="bar-wrap">
      <div class="bar" style="height:${h}px;background:${color}"></div>
      <div class="bar-label">${DIAS[i]}</div>
    </div>`;
  });
  wrap.innerHTML = html;
}

function renderLastTx() {
  const container = document.getElementById('lastTxContainer');
  const txs = [...state.transactions].reverse().slice(0, 5);
  if (!txs.length) {
    container.innerHTML = '<div class="empty"><div class="empty-icon">📭</div><div class="empty-text">Aún no hay movimientos.<br>Cargá el primero.</div></div>';
    return;
  }
  container.innerHTML = txs.map(tx => txRow(tx)).join('');
}

function renderAllTx() {
  const container = document.getElementById('allTxContainer');
  const txs = [...state.transactions].reverse();
  if (!txs.length) {
    container.innerHTML = '<div class="empty"><div class="empty-icon">📋</div><div class="empty-text">No hay movimientos todavía.</div></div>';
    return;
  }
  container.innerHTML = txs.map(tx => `<div class="full-card" style="padding:12px 16px">${txRow(tx)}</div>`).join('');
}

function txRow(tx) {
  const icons = { ingreso: '💰', gasto: '💸', compra: '📦' };
  const colors = { ingreso: 'rgba(76,201,240,0.15)', gasto: 'rgba(248,150,30,0.1)', compra: 'rgba(123,45,139,0.15)' };
  const d = new Date(tx.date);
  const label = tx.desc || tx.cat || tx.type;
  const isIncome = tx.type === 'ingreso';
  return `<div class="tx-item">
    <div class="tx-icon" style="background:${colors[tx.type]}">${icons[tx.type]}</div>
    <div class="tx-info">
      <div class="tx-name">${label}</div>
      <div class="tx-cat">${d.toLocaleDateString('es-AR', {day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'})}</div>
    </div>
    <div class="tx-amount ${isIncome ? 'income' : 'expense'}">${isIncome ? '+' : '-'}${fmt(tx.amount)}</div>
  </div>`;
}

// ============================================================
// CARGAR
// ============================================================
function selectType(type, el) {
  currentType = type;
  selectedCat = null;
  document.querySelectorAll('.type-btn').forEach(b => b.classList.remove('selected'));
  el.classList.add('selected');
  renderCats(type);
}

function renderCats(type) {
  const cats = CATEGORIAS[type] || [];
  const grid = document.getElementById('catGrid');
  selectedCat = null;
  grid.innerHTML = cats.map(c =>
    `<div class="cat-btn" onclick="selectCat('${c.id}', this)">${c.label}</div>`
  ).join('');
}

function selectCat(id, el) {
  selectedCat = id;
  document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('selected'));
  el.classList.add('selected');
}

function registrar() {
  const monto = parseFloat(document.getElementById('montoInput').value);
  const desc = document.getElementById('descInput').value;

  if (!monto || monto <= 0) {
    showToast('⚠️ Ingresá un monto válido', true);
    return;
  }

  const tx = {
    id: Date.now(),
    type: currentType,
    amount: monto,
    cat: selectedCat,
    desc: desc,
    date: new Date().toISOString()
  };

  state.transactions.push(tx);
  save();
  updateDashboard();
  limpiarForm();
  showToast(`✓ ${currentType === 'ingreso' ? 'Ingreso' : 'Gasto'} de ${fmt(monto)} registrado`);
  showScreen('dashboard', null, 'nav-dashboard');
}

function limpiarForm() {
  document.getElementById('montoInput').value = '';
  document.getElementById('descInput').value = '';
  selectedCat = null;
  document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('selected'));
}

// ============================================================
// VOZ
// ============================================================
let recognition = null;
let listening = false;

function toggleVoice() {
  if (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) {
    showToast('⚠️ Tu navegador no soporta voz. Usá Chrome.', true);
    return;
  }

  if (listening) {
    recognition.stop();
    return;
  }

  const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
  recognition = new SpeechRecognition();
  recognition.lang = 'es-AR';
  recognition.continuous = false;
  recognition.interimResults = false;

  recognition.onstart = () => {
    listening = true;
    document.getElementById('voiceBtn').classList.add('listening');
  };

  recognition.onresult = (e) => {
    const transcript = e.results[0][0].transcript;
    procesarVoz(transcript);
  };

  recognition.onend = () => {
    listening = false;
    document.getElementById('voiceBtn').classList.remove('listening');
  };

  recognition.onerror = () => {
    listening = false;
    document.getElementById('voiceBtn').classList.remove('listening');
    showToast('⚠️ No te escuché bien. Intentá de nuevo.', true);
  };

  recognition.start();
}

function procesarVoz(texto) {
  document.getElementById('voicePreview').classList.add('show');
  document.getElementById('voiceText').textContent = '"' + texto + '"';

  const t = texto.toLowerCase();
  const numRegex = /(\d[\d.,]*)\s*(mil|k)?/gi;
  let match, monto = 0;
  while ((match = numRegex.exec(t)) !== null) {
    let num = parseFloat(match[1].replace(',', '.'));
    if (match[2]) num *= 1000;
    if (num > monto) monto = num;
  }

  let tipo = 'gasto';
  if (/entraron|ingresaron|vendimos|venta|cobré|cobré|ingreso/.test(t)) tipo = 'ingreso';
  else if (/compré|compramos|stock|mercadería|mercaderia/.test(t)) tipo = 'compra';

  let cat = null;
  if (/carne|pollo|cerdo|pescado|mercadería|mercaderia|verdura|fruta/.test(t)) cat = 'mercaderia';
  else if (/alquiler/.test(t)) cat = 'alquiler';
  else if (/colegio|inglés|ingles|escuela/.test(t)) cat = 'colegio';
  else if (/nafta|combustible|auto|gasoil/.test(t)) cat = 'auto';
  else if (/venta|ventas|vendimos/.test(t)) cat = 'venta';
  else if (/delivery|pedidos|rappi/.test(t)) cat = 'delivery';

  if (monto > 0) {
    document.getElementById('montoInput').value = monto;
    selectType(tipo, document.querySelector(`.type-btn:nth-child(${tipo === 'ingreso' ? 1 : tipo === 'gasto' ? 2 : 3})`));
    if (cat) {
      setTimeout(() => {
        const catEl = document.querySelector(`[onclick*="${cat}"]`);
        if (catEl) selectCat(cat, catEl);
      }, 100);
    }
    document.getElementById('descInput').value = texto;
    showToast(`🎙️ Escuché: ${tipo} de ${fmt(monto)}`);
  } else {
    showToast('⚠️ No entendí el monto. Intentá de nuevo.', true);
  }
}

// ============================================================
// CONFIG
// ============================================================
function loadConfig() {
  const c = state.config;
  document.getElementById('cfg-equilibrio').value = c.equilibrio || '';
  document.getElementById('cfg-pct-op').value = c.pctOp || 50;
  document.getElementById('cfg-pct-per').value = c.pctPer || 35;
  document.getElementById('cfg-pct-aho').value = c.pctAho || 15;
  document.getElementById('cfg-efectivo').value = c.efectivo || '';
  document.getElementById('cfg-mp').value = c.mp || '';
  document.getElementById('cfg-banco').value = c.banco || '';
  document.getElementById('cfg-alquiler').value = c.alquiler || 500000;
  document.getElementById('cfg-servicios').value = c.servicios || '';
  document.getElementById('cfg-mono').value = c.mono || '';
  document.getElementById('cfg-personal-fijo').value = c.personalFijo || '';
  calcTotalFijos();
}

function guardarConfig() {
  state.config = {
    equilibrio: parseFloat(document.getElementById('cfg-equilibrio').value) || 300000,
    pctOp: parseFloat(document.getElementById('cfg-pct-op').value) || 50,
    pctPer: parseFloat(document.getElementById('cfg-pct-per').value) || 35,
    pctAho: parseFloat(document.getElementById('cfg-pct-aho').value) || 15,
    efectivo: parseFloat(document.getElementById('cfg-efectivo').value) || 0,
    mp: parseFloat(document.getElementById('cfg-mp').value) || 0,
    banco: parseFloat(document.getElementById('cfg-banco').value) || 0,
    alquiler: parseFloat(document.getElementById('cfg-alquiler').value) || 500000,
    servicios: parseFloat(document.getElementById('cfg-servicios').value) || 0,
    mono: parseFloat(document.getElementById('cfg-mono').value) || 0,
    personalFijo: parseFloat(document.getElementById('cfg-personal-fijo').value) || 0
  };
  calcTotalFijos();
  save();
  updateDashboard();
}

function calcTotalFijos() {
  const vals = ['cfg-alquiler','cfg-servicios','cfg-mono','cfg-personal-fijo'];
  const total = vals.reduce((s, id) => s + (parseFloat(document.getElementById(id).value) || 0), 0);
  document.getElementById('cfg-total-fijos').textContent = fmt(total);
}

function resetAll() {
  state.transactions = [];
  state.bolsas = { op: 0, per: 0, aho: 0 };
  save();
  updateDashboard();
  showToast('Datos borrados');
}

// ============================================================
// UTILS
// ============================================================
function fmt(n) {
  if (!n || isNaN(n)) return '$0';
  const abs = Math.abs(n);
  if (abs >= 1000000) return '$' + (n / 1000000).toFixed(1) + 'M';
  if (abs >= 1000) return '$' + Math.round(n / 1000) + 'k';
  return '$' + Math.round(n);
}

function showToast(msg, isError) {
  const t = document.getElementById('toast');
  document.getElementById('toastMsg').textContent = msg;
  t.style.background = isError ? 'var(--yellow)' : 'var(--green)';
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2800);
}

// ============================================================
// EXPORTAR / IMPORTAR
// ============================================================
function exportarDatos() {
  const datos = localStorage.getItem('cocinapop');
  if (!datos) {
    showToast('⚠️ No hay datos para exportar', true);
    return;
  }
  const blob = new Blob([datos], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'cocina-pop-datos.json';
  a.click();
  URL.revokeObjectURL(url);
  showToast('✓ Datos exportados correctamente');
}

function importarDatos(event) {
  const file = event.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = (e) => {
    try {
      const datos = JSON.parse(e.target.result);
      if (!datos.transactions) throw new Error('Archivo inválido');
      localStorage.setItem('cocinapop', JSON.stringify(datos));
      const saved = JSON.parse(localStorage.getItem('cocinapop'));
      state = { ...state, ...saved };
      loadConfig();
      updateDashboard();
      showToast('✓ ' + datos.transactions.length + ' movimientos importados');
    } catch(err) {
      showToast('⚠️ El archivo no es válido', true);
    }
  };
  reader.readAsText(file);
  event.target.value = '';
}

// ============================================================
// START
// ============================================================
init();
</script>
