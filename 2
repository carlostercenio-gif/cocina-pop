<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Cocina Pop">
<meta name="theme-color" content="#1a1a2e">
<meta name="description" content="Finanzas para Cocina Pop">
<title>Cocina Pop — Finanzas</title>

<!-- PWA MANIFEST inline via JS -->
<link rel="manifest" href="manifest.json">

<!-- Apple touch icons (generados inline) -->
<link rel="apple-touch-icon" href="icon-192.png">

<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0f0f1a;
    --surface: #1a1a2e;
    --surface2: #22223b;
    --accent: #f72585;
    --green: #4cc9f0;
    --yellow: #f8961e;
    --red: #ef233c;
    --text: #edf2f4;
    --muted: #8d99ae;
    --card: #16213e;
    --border: rgba(255,255,255,0.07);
    --radius: 20px;
    --radius-sm: 12px;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'DM Sans', sans-serif;
    min-height: 100vh;
    padding-bottom: 100px;
    overflow-x: hidden;
  }

  .header {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    padding: 20px 20px 0;
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--border);
  }

  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .logo {
    font-family: 'Syne', sans-serif;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.5px;
  }

  .logo span { color: var(--accent); }

  .date-chip {
    background: var(--surface2);
    border: 1px solid var(--border);
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    color: var(--muted);
  }

  .tabs {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 16px;
  }
  .tabs::-webkit-scrollbar { display: none; }

  .tab {
    flex-shrink: 0;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    border: none;
    background: transparent;
    color: var(--muted);
    transition: all 0.2s;
  }

  .tab.active {
    background: var(--accent);
    color: white;
  }

  .screen { display: none; padding: 20px; animation: fadeIn 0.3s ease; }
  .screen.active { display: block; }

  @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

  .status-bar {
    background: linear-gradient(135deg, var(--card), var(--surface2));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    margin-bottom: 16px;
    position: relative;
    overflow: hidden;
  }

  .status-bar::before {
    content: '';
    position: absolute;
    top: -30px; right: -30px;
    width: 120px; height: 120px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.05;
  }

  .status-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--muted);
    margin-bottom: 6px;
  }

  .status-amount {
    font-family: 'Syne', sans-serif;
    font-size: 36px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1;
    margin-bottom: 12px;
  }

  .status-amount.green { color: var(--green); }
  .status-amount.yellow { color: var(--yellow); }
  .status-amount.red { color: var(--red); }

  .status-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .status-chip {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--muted);
  }

  .status-chip .dot {
    width: 8px; height: 8px;
    border-radius: 50%;
  }

  .alert-card {
    border-radius: var(--radius-sm);
    padding: 14px 16px;
    margin-bottom: 12px;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 14px;
    line-height: 1.5;
    border: 1px solid;
  }

  .alert-card.good { background: rgba(76,201,240,0.08); border-color: rgba(76,201,240,0.2); color: var(--green); }
  .alert-card.warn { background: rgba(248,150,30,0.08); border-color: rgba(248,150,30,0.2); color: var(--yellow); }
  .alert-card.danger { background: rgba(239,35,60,0.08); border-color: rgba(239,35,60,0.2); color: var(--red); }
  .alert-card.neutral { background: var(--surface2); border-color: var(--border); color: var(--muted); }

  .alert-icon { font-size: 18px; flex-shrink: 0; margin-top: 1px; }
  .alert-text { color: var(--text); }
  .alert-text strong { display: block; margin-bottom: 2px; }

  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px; }

  .mini-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 16px;
  }

  .mini-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--muted);
    margin-bottom: 8px;
  }

  .mini-amount {
    font-family: 'Syne', sans-serif;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.5px;
  }

  .mini-sub {
    font-size: 11px;
    color: var(--muted);
    margin-top: 4px;
  }

  .progress-wrap { margin-bottom: 16px; }
  .progress-header { display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 13px; }
  .progress-header span:last-child { color: var(--muted); font-size: 12px; }
  .progress-track {
    height: 8px;
    background: var(--surface2);
    border-radius: 4px;
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    border-radius: 4px;
    transition: width 0.8s cubic-bezier(0.4,0,0.2,1);
  }
  .progress-fill.green { background: linear-gradient(90deg, #4cc9f0, #7bf1a8); }
  .progress-fill.yellow { background: linear-gradient(90deg, #f8961e, #f9c74f); }
  .progress-fill.red { background: linear-gradient(90deg, #ef233c, #f72585); }

  .section-title {
    font-family: 'Syne', sans-serif;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--muted);
    margin: 20px 0 12px;
  }

  .full-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    margin-bottom: 12px;
  }

  .full-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .full-card-title {
    font-family: 'Syne', sans-serif;
    font-size: 16px;
    font-weight: 700;
  }

  .badge {
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .badge.green { background: rgba(76,201,240,0.15); color: var(--green); }
  .badge.yellow { background: rgba(248,150,30,0.15); color: var(--yellow); }
  .badge.red { background: rgba(239,35,60,0.15); color: var(--red); }

  .tx-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
  }
  .tx-item:last-child { border-bottom: none; }

  .tx-icon {
    width: 40px; height: 40px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }

  .tx-info { flex: 1; min-width: 0; }
  .tx-name { font-size: 14px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tx-cat { font-size: 11px; color: var(--muted); margin-top: 2px; }
  .tx-amount { font-family: 'Syne', sans-serif; font-size: 15px; font-weight: 700; flex-shrink: 0; }
  .tx-amount.income { color: var(--green); }
  .tx-amount.expense { color: var(--text); }

  .form-group { margin-bottom: 16px; }
  .form-label { font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: var(--muted); margin-bottom: 8px; display: block; }

  .form-input {
    width: 100%;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 14px 16px;
    color: var(--text);
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    outline: none;
    transition: border-color 0.2s;
  }
  .form-input:focus { border-color: var(--accent); }
  .form-input::placeholder { color: var(--muted); }

  .form-input.big {
    font-family: 'Syne', sans-serif;
    font-size: 28px;
    font-weight: 700;
    text-align: center;
    letter-spacing: -0.5px;
  }

  .type-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }

  .type-btn {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 12px 8px;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s;
    color: var(--muted);
    font-size: 12px;
    font-family: 'DM Sans', sans-serif;
  }

  .type-btn .emoji { font-size: 20px; display: block; margin-bottom: 4px; }
  .type-btn.selected { border-color: var(--accent); color: var(--text); background: rgba(247,37,133,0.1); }

  .cat-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }

  .cat-btn {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 10px 12px;
    text-align: left;
    cursor: pointer;
    transition: all 0.2s;
    color: var(--muted);
    font-size: 13px;
    font-family: 'DM Sans', sans-serif;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .cat-btn.selected { border-color: var(--accent); color: var(--text); background: rgba(247,37,133,0.1); }

  .btn-primary {
    width: 100%;
    background: var(--accent);
    color: white;
    border: none;
    border-radius: var(--radius-sm);
    padding: 16px;
    font-family: 'Syne', sans-serif;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    margin-top: 8px;
    letter-spacing: 0.5px;
  }
  .btn-primary:active { transform: scale(0.98); opacity: 0.9; }

  .btn-secondary {
    width: 100%;
    background: transparent;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 14px;
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    cursor: pointer;
    margin-top: 8px;
  }

  .voice-area {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
    text-align: center;
    margin-bottom: 20px;
  }

  .voice-btn {
    width: 80px; height: 80px;
    border-radius: 50%;
    background: var(--accent);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    margin: 0 auto 16px;
    transition: all 0.2s;
    box-shadow: 0 0 0 0 rgba(247,37,133,0.4);
  }

  .voice-btn.listening {
    animation: pulse 1.5s infinite;
  }

  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(247,37,133,0.4); }
    70% { box-shadow: 0 0 0 20px rgba(247,37,133,0); }
    100% { box-shadow: 0 0 0 0 rgba(247,37,133,0); }
  }

  .voice-hint { font-size: 13px; color: var(--muted); line-height: 1.6; }
  .voice-hint strong { color: var(--text); display: block; margin-bottom: 4px; }

  .voice-preview {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 14px 16px;
    margin-top: 16px;
    font-size: 14px;
    display: none;
  }

  .voice-preview.show { display: block; }
  .voice-preview-label { font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--muted); margin-bottom: 6px; }
  .voice-preview-text { color: var(--green); font-weight: 500; }

  .bottom-nav {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    background: rgba(15,15,26,0.95);
    backdrop-filter: blur(20px);
    border-top: 1px solid var(--border);
    display: flex;
    padding: 8px 0 20px;
    z-index: 200;
  }

  .nav-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 8px 4px;
    cursor: pointer;
    border: none;
    background: transparent;
    color: var(--muted);
    font-size: 10px;
    font-family: 'DM Sans', sans-serif;
    transition: all 0.2s;
  }

  .nav-item.active { color: var(--accent); }
  .nav-icon { font-size: 22px; }

  .nav-item.center-btn {
    position: relative;
    top: -16px;
  }

  .nav-item.center-btn .nav-icon {
    width: 56px; height: 56px;
    border-radius: 50%;
    background: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    box-shadow: 0 4px 20px rgba(247,37,133,0.4);
  }

  .toast {
    position: fixed;
    top: 20px; left: 20px; right: 20px;
    background: var(--green);
    color: #0f0f1a;
    border-radius: var(--radius-sm);
    padding: 14px 16px;
    font-weight: 600;
    font-size: 14px;
    z-index: 999;
    transform: translateY(-100px);
    transition: transform 0.3s cubic-bezier(0.4,0,0.2,1);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .toast.show { transform: translateY(0); }

  /* INSTALL BANNER */
  .install-banner {
    position: fixed;
    bottom: 90px; left: 16px; right: 16px;
    background: linear-gradient(135deg, #1a1a2e, #22223b);
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    padding: 16px;
    z-index: 300;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: 0 8px 32px rgba(247,37,133,0.2);
    transform: translateY(200px);
    transition: transform 0.4s cubic-bezier(0.4,0,0.2,1);
  }
  .install-banner.show { transform: translateY(0); }
  .install-banner-icon { font-size: 32px; flex-shrink: 0; }
  .install-banner-text { flex: 1; }
  .install-banner-title { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 14px; }
  .install-banner-sub { font-size: 12px; color: var(--muted); margin-top: 2px; }
  .install-banner-btns { display: flex; gap: 8px; flex-shrink: 0; }
  .install-btn {
    background: var(--accent);
    color: white;
    border: none;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    font-family: 'DM Sans', sans-serif;
  }
  .dismiss-btn {
    background: transparent;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 13px;
    cursor: pointer;
    font-family: 'DM Sans', sans-serif;
  }

  .week-chart {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    height: 80px;
    padding: 0 4px;
  }

  .bar-wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    height: 100%;
    justify-content: flex-end;
  }

  .bar {
    width: 100%;
    border-radius: 6px 6px 0 0;
    transition: height 0.8s cubic-bezier(0.4,0,0.2,1);
    min-height: 4px;
  }

  .bar-label { font-size: 10px; color: var(--muted); }

  .setting-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }
  .setting-row:last-child { border-bottom: none; }
  .setting-label { font-size: 14px; }
  .setting-sub { font-size: 12px; color: var(--muted); margin-top: 2px; }

  .setting-input {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 8px 12px;
    color: var(--text);
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    width: 130px;
    text-align: right;
    outline: none;
  }
  .setting-input:focus { border-color: var(--accent); }

  .divider { height: 1px; background: var(--border); margin: 8px 0; }

  .empty { text-align: center; padding: 40px 20px; color: var(--muted); }
  .empty-icon { font-size: 48px; margin-bottom: 12px; }
  .empty-text { font-size: 14px; line-height: 1.6; }
</style>
</head>
<body>

<div class="toast" id="toast">✓ <span id="toastMsg">Registrado</span></div>

<!-- INSTALL BANNER -->
<div class="install-banner" id="installBanner">
  <div class="install-banner-icon">📲</div>
  <div class="install-banner-text">
    <div class="install-banner-title">Instalar Cocina Pop</div>
    <div class="install-banner-sub">Usala como app en tu celular</div>
  </div>
  <div class="install-banner-btns">
    <button class="install-btn" onclick="instalarApp()">Instalar</button>
    <button class="dismiss-btn" onclick="cerrarBanner()">✕</button>
  </div>
</div>

<!-- HEADER -->
<div class="header">
  <div class="header-top">
    <div class="logo">Cocina <span>Pop</span></div>
    <div class="date-chip" id="dateChip"></div>
  </div>
  <div class="tabs">
    <button class="tab active" onclick="showScreen('dashboard', this)">Dashboard</button>
    <button class="tab" onclick="showScreen('cargar', this)">Cargar</button>
    <button class="tab" onclick="showScreen('movimientos', this)">Movimientos</button>
    <button class="tab" onclick="showScreen('config', this)">Configurar</button>
  </div>
</div>

<!-- DASHBOARD -->
<div class="screen active" id="screen-dashboard">

  <div class="status-bar" id="mainStatusBar">
    <div class="status-label">Disponible hoy</div>
    <div class="status-amount" id="disponibleAmount">$0</div>
    <div class="status-row" id="statusRow">
      <div class="status-chip"><div class="dot" style="background:var(--green)"></div><span id="chip-op">Operativo $0</span></div>
      <div class="status-chip"><div class="dot" style="background:var(--yellow)"></div><span id="chip-per">Personal $0</span></div>
      <div class="status-chip"><div class="dot" style="background:var(--accent)"></div><span id="chip-aho">Ahorro $0</span></div>
    </div>
  </div>

  <div id="alertContainer"></div>

  <div class="full-card">
    <div class="full-card-header">
      <div class="full-card-title">Punto de equilibrio</div>
      <div class="badge" id="eqBadge">—</div>
    </div>
    <div class="progress-wrap">
      <div class="progress-header">
        <span>Vendido hoy</span>
        <span id="eqProgressLabel">—</span>
      </div>
      <div class="progress-track">
        <div class="progress-fill" id="eqBar" style="width:0%"></div>
      </div>
    </div>
    <div style="font-size:13px; color:var(--muted); line-height:1.6" id="eqMessage">
      Cargá las ventas del día para ver cómo estás parado.
    </div>
  </div>

  <div class="grid2">
    <div class="mini-card">
      <div class="mini-label">🏪 Negocio</div>
      <div class="mini-amount" id="mini-op" style="color:var(--green)">$0</div>
      <div class="mini-sub">Caja operativa</div>
    </div>
    <div class="mini-card">
      <div class="mini-label">🏠 Personal</div>
      <div class="mini-amount" id="mini-per" style="color:var(--yellow)">$0</div>
      <div class="mini-sub">Vida familiar</div>
    </div>
    <div class="mini-card">
      <div class="mini-label">🐖 Ahorro</div>
      <div class="mini-amount" id="mini-aho" style="color:var(--accent)">$0</div>
      <div class="mini-sub">Colchón</div>
    </div>
    <div class="mini-card">
      <div class="mini-label">📊 Este mes</div>
      <div class="mini-amount" id="mini-mes" style="color:var(--text)">$0</div>
      <div class="mini-sub">Ventas totales</div>
    </div>
  </div>

  <div class="full-card">
    <div class="full-card-header">
      <div class="full-card-title">Esta semana</div>
      <div style="font-size:12px;color:var(--muted)">L a V</div>
    </div>
    <div class="week-chart" id="weekChart"></div>
    <div class="divider" style="margin-top:16px"></div>
    <div style="display:flex;justify-content:space-between;margin-top:12px;font-size:13px">
      <span style="color:var(--muted)">Promedio diario</span>
      <span id="promedioDiario" style="font-weight:600">$0</span>
    </div>
    <div style="display:flex;justify-content:space-between;margin-top:8px;font-size:13px">
      <span style="color:var(--muted)">Mejor día</span>
